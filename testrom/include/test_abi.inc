; NR-RetroWorks SuperFX3 diagnostic ROM
; Shared constants used by the 65816 supervisor.

TEST_RESULT_PASS    = 0
TEST_RESULT_FAIL    = 1
TEST_RESULT_TIMEOUT = 2

TEST_FLAG_CPU_ONLY = $01
TEST_FLAG_VISUAL   = $02
TEST_FLAG_REPEAT   = $04

SETUP_NONE       = 0
SETUP_CPU_REG    = 1
SETUP_RAM_MAGIC  = 2
SETUP_PLOT       = 3
SETUP_CLEAR      = 4
SETUP_C2P_NOOP   = 5

VALIDATE_VCR       = 0
VALIDATE_CPU_REG   = 1
VALIDATE_COMPLETE  = 2
VALIDATE_RAM_MAGIC = 3
VALIDATE_ALU       = 4
VALIDATE_ROM       = 5
VALIDATE_PLOT      = 6
VALIDATE_RPIX      = 7
VALIDATE_CLEAR     = 8
VALIDATE_C2P_NOOP  = 9
VALIDATE_PIPELINE  = 10
VALIDATE_PLOT_PATTERN = 11

; Test descriptor, fixed at 16 bytes so indexing is four shifts.
TD_NAME      = 0
TD_KERNEL    = 2
TD_TIMEOUT   = 4
TD_PARAM0    = 6
TD_PARAM1    = 8
TD_EXPECTED  = 10
TD_BANK      = 12
TD_SETUP     = 13
TD_VALIDATOR = 14
TD_FLAGS     = 15
TD_SIZE      = 16

; Shared RAM locations used as a tiny diagnostic ABI.
TEST_RAM_BANK     = $70
TEST_RAM_MAGIC    = $0200
TEST_RAM_ALU      = $0202
TEST_RAM_ROM      = $0204
TEST_RAM_RPIX     = $0206
TEST_RAM_GUARD_LO = $01FE
TEST_RAM_GUARD_HI = $0208
TEST_RAM_PIPE     = $020A
TEST_RAM_PIPE_GUARD = $020C

FX3_PLANAR_BANK   = $71
FX3_PLANAR_OFFSET = $0000
FX3_CLEAR_SENTINEL = $A5
