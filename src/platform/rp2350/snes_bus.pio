; NR-RetroWorks SuperFX3 Firmware
; RP2350B SNES cartridge bus front end

.pio_version 1

; Pioasm cannot consume the C board-header macros used by the rest of the firmware,
; so WAIT GPIO operands below remain numeric. tests/pio_static_tests.py verifies
; those operands against boards/snes_fx3.h to keep the PIO source and PCB map locked together.

; GPIO27 is an internal service-select signal. PIO0 continuously decodes
; A12-A15 so PIO1/PIO2 can reject unrelated SNES transactions quickly.
; FIXME: Verify GPIO27 service-select setup time relative to /RD and /WR.
; The select bit comes from a separate PIO0 state machine, so capture a trace and prove
; the read/write state machines never sample a stale decode.
.program snes_select_fx3
.wrap_target
select_fx3_loop:
    mov isr, null
    in pins, 4
    mov x, isr
    set y, 7
    jmp x!=y fx3_not_selected
    set pins, 1
    jmp select_fx3_loop
fx3_not_selected:
    set pins, 0
.wrap

.program snes_select_gsu
.wrap_target
select_gsu_loop:
    mov isr, null
    in pins, 4
    mov x, isr
    set y, 3
    jmp x!=y gsu_check_6
    set pins, 1
    jmp select_gsu_loop
gsu_check_6:
    set y, 6
    jmp x!=y gsu_check_7
    set pins, 1
    jmp select_gsu_loop
gsu_check_7:
    set y, 7
    jmp x!=y gsu_not_selected
    set pins, 1
    jmp select_gsu_loop
gsu_not_selected:
    set pins, 0
.wrap

; PIO0 captures A0-A15 on every /WR assertion. DMA forwards each capture
; directly into the PIO1 write state machine TX FIFO.
.program snes_write_addr
.wrap_target
    wait 0 gpio 21
    mov isr, null
    in pins, 16
    push block
    wait 1 gpio 21
.wrap

; PIO1 uses the GPIO16-47 window. It captures A16-A23 + D0-D7 immediately after
; /WR asserts, then pulls the matching PIO0 A0-A15 capture through DMA.
; FIXME: Stress-test write pairing through FIFO saturation and pause/resume.
; Normal FIFO ordering keeps A0-A15 matched with A16-A23+D0-D7, but hardware testing must
; prove that no captured write is dropped or paired with the following transaction.
; With IN shifting left, rebuilding ISR with IN Y,16 produces:
;   bits  0-7  = A16-A23
;   bits  8-15 = D0-D7
;   bits 16-31 = A0-A15
.program snes_write_fx3
.wrap_target
write_fx3_loop:
    wait 0 gpio 21
    mov isr, null
    in pins, 16
    mov y, isr
    pull block
    mov isr, osr
    in y, 16
    jmp pin fx3_cpu_write

    mov osr, isr
    out null, 1
    out x, 5
    set y, 24
    jmp x!=y fx3_write_ignore
    out x, 1
    jmp !x fx3_write_ignore
    out x, 1
    jmp !x fx3_cpu_write

fx3_write_ignore:
    wait 1 gpio 21
    jmp write_fx3_loop

fx3_cpu_write:
    push block
    irq wait 1
    wait 1 gpio 21
    jmp write_fx3_loop
.wrap

.program snes_write_gsu
.wrap_target
write_gsu_loop:
    wait 0 gpio 21
    mov isr, null
    in pins, 16
    mov y, isr
    pull block
    mov isr, osr
    in y, 16
    jmp pin gsu_cpu_write

    mov osr, isr
    out null, 1
    out x, 5
    set y, 24
    jmp x!=y gsu_write_ignore
    out x, 1
    jmp !x gsu_write_ignore
    jmp gsu_cpu_write

gsu_write_ignore:
    wait 1 gpio 21
    jmp write_gsu_loop

gsu_cpu_write:
    push block
    irq wait 1
    wait 1 gpio 21
    jmp write_gsu_loop
.wrap

.program snes_reset
.wrap_target
    wait 0 gpio 23
    irq 2
    wait 1 gpio 23
.wrap

; Read-control pins are arranged for PCB routing as two adjacent pairs:
;   GPIO28 /ROM0_OE  (SET pin)
;   GPIO29 /ROM1_OE  (side-set bit0)
;   GPIO30 /BUS_OE   (side-set bit1)
;   GPIO31 DATA_DIR  (side-set bit2)
;
; side 1 = SNES -> RP2350, bus connected, ROM1 disabled
; side 5 = cart -> SNES, bus connected, ROM1 disabled
; side 4 = cart -> SNES, bus connected, ROM1 enabled
; side 7 = cart -> SNES, bus isolated, ROM1 disabled
;
; /ROM0_OE is controlled through SET. This keeps both ROM enables together on
; GPIO28-GPIO29 while BUS_OE and DATA_DIR stay together on GPIO30-GPIO31.
;
; The response word supplied by core0 is:
;   bit 0      1 to drive, 0 to ignore this non-cartridge read
;   bits 1-8   data byte
;   bits 9-16  0xFF when driving, to enable D0-D7 PIO directions
;   bits 17-24 zero, to release D0-D7 after /RD rises
;
; FIXME: Close the SNES read timing budget with a worst-case hardware measurement.
; Include PIO input synchronization, decode latency, ROM /OE assertion, CPU IRQ service,
; data-direction changes, and the final data-valid margin before /RD rises.
;
; $70/$71 are removed from the parallel-ROM path for shared SRAM. Other /ROMSEL
; cycles remain direct parallel-ROM reads so a pre-striped bus image can expose the
; intended SNES ROM map without changing address lines during a read.
;
; X = 56 matches $70/$71 in FX3 (seven bits), or $70/$71 + $F0/$F1
; in legacy GSU (six bits). Legacy X = 0 means ROM is blocked.
; The CPU response bit 0 selects drive (1) versus ignore (0). Keep DATA_DIR
; inward until that response qualifies the address, including while waiting for IRQ.

.program snes_read_fx3
.side_set 3
.wrap_target
read_fx3_loop:
    wait 0 gpio 20 side 1
    in pins, 18 side 1
    mov osr, isr side 1
    out y, 1 side 1
    jmp !y fx3_snes_read side 1
    jmp pin fx3_cpu_read side 1
    jmp read_fx3_loop side 1

fx3_snes_read:
    out null, 10 side 1
    out y, 7 side 1
    jmp x!=y fx3_rom_select side 1

fx3_cpu_read:
    irq 0 side 1
    pull block side 1
    out y, 1 side 1
    jmp !y fx3_ignore_read side 1
    out pins, 8 side 1
    out pindirs, 8 side 5
    wait 1 gpio 20 side 5 [3]
    out pindirs, 8 side 5
    jmp read_fx3_loop side 1 [3]

fx3_rom_select:
    nop side 5

fx3_rom0_wait:
    set pins, 0 side 5
    wait 1 gpio 20 side 5 [3]
    set pins, 1 side 5 [3]
    jmp read_fx3_loop side 1 [3]

fx3_ignore_read:
    wait 1 gpio 20 side 1
    jmp read_fx3_loop side 1
.wrap

.program snes_read_fx3_dual
.side_set 3
.wrap_target
read_fx3_dual_loop:
    wait 0 gpio 20 side 1
    in pins, 18 side 1
    mov osr, isr side 1
    out y, 1 side 1
    jmp !y fx3_dual_snes_read side 1
    jmp pin fx3_dual_cpu_read side 1
    jmp read_fx3_dual_loop side 1

fx3_dual_snes_read:
    out null, 10 side 1
    out y, 7 side 1
    mov osr, y side 1
    jmp x!=y fx3_dual_rom_select side 1

fx3_dual_cpu_read:
    irq 0 side 1
    pull block side 1
    out y, 1 side 1
    jmp !y fx3_dual_ignore_read side 1
    out pins, 8 side 1
    out pindirs, 8 side 5
    wait 1 gpio 20 side 5 [3]
    out pindirs, 8 side 5
    jmp read_fx3_dual_loop side 1 [3]

fx3_dual_rom_select:
    out null, 6 side 1
    out y, 1 side 1
    jmp !y fx3_dual_rom0_wait side 5
    wait 1 gpio 20 side 4 [3]
    jmp read_fx3_dual_loop side 5 [3]

fx3_dual_rom0_wait:
    set pins, 0 side 5
    wait 1 gpio 20 side 5 [3]
    set pins, 1 side 5 [3]
    jmp read_fx3_dual_loop side 1 [3]

fx3_dual_ignore_read:
    wait 1 gpio 20 side 1
    jmp read_fx3_dual_loop side 1
.wrap

.program snes_read_gsu
.side_set 3
.wrap_target
read_gsu_loop:
    wait 0 gpio 20 side 1
    in pins, 18 side 1
    mov osr, isr side 1
    out y, 1 side 1
    jmp !y gsu_snes_read side 1
    jmp pin gsu_cpu_read side 1
    jmp read_gsu_loop side 1

gsu_snes_read:
    jmp !x gsu_cpu_read side 1
    out null, 10 side 1
    out y, 6 side 1
    jmp x!=y gsu_rom_select side 1

gsu_cpu_read:
    irq 0 side 1
    pull block side 1
    out y, 1 side 1
    jmp !y gsu_ignore_read side 1
    out pins, 8 side 1
    out pindirs, 8 side 5
    wait 1 gpio 20 side 5 [3]
    out pindirs, 8 side 5
    jmp read_gsu_loop side 1 [3]

gsu_rom_select:
    nop side 5

gsu_rom0_wait:
    set pins, 0 side 5
    wait 1 gpio 20 side 5 [3]
    set pins, 1 side 5 [3]
    jmp read_gsu_loop side 1 [3]

gsu_ignore_read:
    wait 1 gpio 20 side 1
    jmp read_gsu_loop side 1
.wrap

.program snes_read_gsu_dual
.side_set 3
.wrap_target
read_gsu_dual_loop:
    wait 0 gpio 20 side 1
    in pins, 18 side 1
    mov osr, isr side 1
    out y, 1 side 1
    jmp !y gsu_dual_snes_read side 1
    jmp pin gsu_dual_cpu_read side 1
    jmp read_gsu_dual_loop side 1

gsu_dual_snes_read:
    jmp !x gsu_dual_cpu_read side 1
    out null, 10 side 1
    out y, 6 side 1
    jmp x!=y gsu_dual_rom_select side 1

gsu_dual_cpu_read:
    irq 0 side 1
    pull block side 1
    out y, 1 side 1
    jmp !y gsu_dual_ignore_read side 1
    out pins, 8 side 1
    out pindirs, 8 side 5
    wait 1 gpio 20 side 5 [3]
    out pindirs, 8 side 5
    jmp read_gsu_dual_loop side 1 [3]

gsu_dual_rom_select:
    out y, 1 side 1
    jmp !y gsu_dual_rom0_wait side 5
    wait 1 gpio 20 side 4 [3]
    jmp read_gsu_dual_loop side 5 [3]

gsu_dual_rom0_wait:
    set pins, 0 side 5
    wait 1 gpio 20 side 5 [3]
    set pins, 1 side 5 [3]
    jmp read_gsu_dual_loop side 1 [3]

gsu_dual_ignore_read:
    wait 1 gpio 20 side 1
    jmp read_gsu_dual_loop side 1
.wrap
