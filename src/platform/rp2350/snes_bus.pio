; NR-RetroWorks SuperFX3 Firmware
; Routed RP2350B SNES cartridge bus front end

.pio_version 1

; Pioasm cannot consume the C board-header macros used by the firmware. Static
; tests lock every numeric WAIT operand and pin mapping to boards/snes_fx3.h.

; PIO0, GPIO base 0. Commands are seven-bit GPIO1-GPIO7 control values:
; /RD, /WR, /ROM_CE, /A_OE, /C_OE, D_DIR, /D_OE.
.program snes_control_output
.wrap_target
    pull block
    out pins, 7
.wrap

; PIO0, GPIO base 0. A PIO1 write trigger arrives through DMA, causing one
; simultaneous raw GPIO8-GPIO31 address capture. DMA returns the 24-bit word to
; the PIO1 write-capture TX FIFO.
.program snes_write_address
.wrap_target
    pull block
    mov isr, null
    in pins, 24
    push block
.wrap

; PIO1, GPIO base 16. This tiny producer converts /I_WR edges into DMA triggers
; for the lower-window address-capture state machine.
.program snes_write_trigger
.wrap_target
    wait 0 gpio 35
    set x, 1
    mov isr, x
    push block
    wait 1 gpio 35
.wrap

; PIO1, GPIO base 16. Capture routed GPIO40-GPIO47 data, wait for the paired
; raw address word, and pack one CPU-visible transaction as:
;   bits  0-7  = raw GPIO40-GPIO47 data
;   bits  8-31 = raw GPIO8-GPIO31 address
.program snes_write_capture
.wrap_target
    wait 0 gpio 35
    mov isr, null
    in pins, 8
    mov y, isr
    pull block
    mov isr, osr
    in y, 8
    push block
    irq wait 1
    wait 1 gpio 35
.wrap

; PIO1, GPIO base 16. Reset remains live independently of read/write traffic.
.program snes_reset
.wrap_target
    wait 0 gpio 36
    irq 2
    wait 1 gpio 36
.wrap

; PIO2, GPIO base 16. /I_CART is the JMP pin and /I_RD is the timing strobe.
; A selected cartridge read immediately sends the direct-ROM control word 0x22
; to PIO0 before raising the CPU service IRQ. Core 0 replies with:
;   bit 0      1 to override the direct path, 0 to leave it unchanged
;   bits 1-8   data in routed GPIO40-GPIO47 order
;   bits 9-15  seven-bit GPIO1-GPIO7 active control word
;   bits 16-23 data-pin direction mask (0xFF to drive, zero to remain input)
;
; This preserves the existing early-ROM-enable policy for timing. $70/$71 RAM,
; MMIO, blocked legacy ROM, and unmapped reads override it before data is driven.
.program snes_read
.wrap_target
snes_read_loop:
    wait 0 gpio 34
    jmp pin snes_read_service

    ; Build direct-read control word 0x22: (17 << 1).
    mov isr, null
    set y, 17
    in y, 5
    in null, 1
    push block

snes_read_service:
    irq 0
    pull block
    out y, 1
    jmp !y snes_read_wait_release
    out pins, 8
    out y, 7
    mov isr, y
    push block
    nop [1]
    out pindirs, 8

snes_read_wait_release:
    wait 1 gpio 34
    ; SET supports at most five pins. OUT covers all eight data pins.
    mov osr, null
    out pindirs, 8
    mov isr, x
    push block
    jmp snes_read_loop
.wrap
